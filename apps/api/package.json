{
  "name": "@research-max/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "start": "node dist/server.js",
    "worker:dev": "node --env-file=../../.env --import tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "test": "vitest run",
    "test:persistence": "vitest run tests/persistence.test.ts tests/supabase_store.test.ts",
    "eval:durable-jobs": "node --env-file=../../.env --import tsx src/evaluation/durable-job-smoke.ts",
    "eval:durable-api-restart": "node --env-file=../../.env --import tsx src/evaluation/durable-job-api-restart.ts",
    "eval:durable-job-auth": "node --env-file=../../.env --import tsx src/evaluation/durable-job-authenticated-research.ts",
    "eval:backend-integration": "node --env-file=../../.env --import tsx src/evaluation/durable-job-authenticated-research.ts",
    "eval:serper-research-integration": "node --env-file=../../.env --import tsx src/evaluation/serper-citation-integration.ts --research-only",
    "eval:research-chat-adaptive-smoke": "node --env-file=../../.env --import tsx src/evaluation/research-chat-adaptive-smoke.ts",
    "eval:model-bakeoff": "node --env-file=../../.env --import tsx src/evaluation/model-bakeoff.ts",
    "check:live-network": "node --env-file=../../.env --import tsx src/evaluation/check-live-network.ts",
    "eval:supabase-smoke": "node --env-file=../../.env --import tsx src/evaluation/supabase-persistence-smoke.ts",
    "eval:auth-smoke": "node --env-file=../../.env --import tsx src/evaluation/auth-smoke.ts",
    "eval:semantic-memory-smoke": "node --env-file=../../.env --import tsx src/evaluation/semantic-memory-smoke.ts",
    "eval:auth-ownership": "node --env-file=../../.env --import tsx src/evaluation/auth-ownership-diagnostic.ts",
    "eval:sharing-smoke": "node --env-file=../../.env --import tsx src/evaluation/sharing-smoke.ts",
    "eval:exports-smoke": "node --env-file=../../.env --import tsx src/evaluation/exports-smoke.ts",
    "eval": "vitest run tests/agent_decision.test.ts tests/tool_decision.test.ts tests/trajectory.test.ts tests/research_loop.test.ts",
    "eval:citations": "vitest run tests/citation_entailment.test.ts tests/citation_e2e.test.ts",
    "eval:citation-e2e": "node --env-file=../../.env --import tsx src/evaluation/citation-e2e.ts",
    "eval:citation-product-e2e": "node --env-file=../../.env --import tsx src/evaluation/citation-product-e2e.ts",
    "eval:post-agent": "vitest run tests/content_agent.test.ts tests/autonomous_research_e2e.test.ts tests/post_quality.test.ts tests/post_followup.test.ts tests/platform_api.test.ts",
    "eval:post-e2e": "node --env-file=../../.env --import tsx src/evaluation/post-agent-e2e.ts",
    "eval:retrieval-smoke": "node --env-file=../../.env --import tsx src/evaluation/source-retrieval-smoke.ts",
    "eval:smoke": "node --env-file=../../.env --import tsx src/evaluation/real.ts --profile=smoke",
    "eval:quality-smoke": "node --env-file=../../.env --import tsx src/evaluation/quality.ts --smoke",
    "eval:quality-pack": "node --env-file=../../.env --import tsx src/evaluation/quality.ts --pack=4",
    "eval:quality": "node --env-file=../../.env --import tsx src/evaluation/quality.ts",
    "eval:real": "node --env-file=../../.env --import tsx src/evaluation/real.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@supabase/supabase-js": "2.117.1",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "0.20.2",
    "playwright-core": "^1.63.0",
    "undici": "^8.11.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
