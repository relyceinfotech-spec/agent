NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SERPER_API_KEY=
SERPER_GL=in
SERPER_HL=en
MAX_DATABASE_PATH=data/max.sqlite
MAX_PERSISTENCE_PROVIDER=sqlite
MAX_JOB_WORKER_CONCURRENCY=1
MAX_JOB_LEASE_SECONDS=45
MAX_JOB_POLL_INTERVAL_MS=1000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback; backend-only. Prefer SUPABASE_SECRET_KEY for new Supabase keys.
SUPABASE_SERVICE_ROLE_KEY=
# Public project key used with the user's JWT for RLS-scoped persistence.
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
MAX_USER_RESEARCH_PER_WINDOW=20
MAX_USER_DEEP_RESEARCH_PER_WINDOW=3
MAX_USER_FOLLOWUPS_PER_WINDOW=5
USER_QUOTA_WINDOW_SECONDS=86400
MAX_DEFAULT_QUOTA_PLAN=default
# Billing v1 prices and canonical Free/Pro plan data live in Signova's billing.plans table.
# The seeded Pro plan stays inactive with empty prices/limits until business values are approved.
# Optional JSON map: plan id -> {enabled, quotas, features, billingMetadata}.
# Each quota entry has {limit, windowSeconds}; per-user plan assignment is optional JSON user-id -> plan-id.
MAX_QUOTA_PLANS_JSON=
MAX_USER_PLAN_OVERRIDES_JSON=
MAX_TOPIC_FEEDS=https://github.blog/feed/,https://blog.cloudflare.com/rss/,https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml,https://www.engadget.com/rss.xml,https://feeds.arstechnica.com/arstechnica/index,https://feeds.venturebeat.com/VentureBeat,https://feeds.arstechnica.com/arstechnica/technology-lab,https://feeds.arstechnica.com/arstechnica/gadgets,https://electrek.co/feed/,https://feeds.arstechnica.com/arstechnica/cars,https://www.supplychaindive.com/feeds/news/,https://www.freightwaves.com/feed,https://www.retaildive.com/feeds/news/,https://www.marketingdive.com/feeds/news/,https://www.bleepingcomputer.com/feed/,https://krebsonsecurity.com/feed/,https://www.cybersecuritydive.com/feeds/news/,https://www.utilitydive.com/feeds/news/,https://www.energy.gov/listings/energy-news?view=rss,https://www.sebi.gov.in/sebirss.xml,https://rbi.org.in/pressreleases_rss.xml,https://rbi.org.in/notifications_rss.xml,https://www.sec.gov/news/pressreleases.rss,https://www.ftc.gov/feeds/press-release.xml,https://www.ftc.gov/feeds/press-release-competition.xml,https://www.cpsc.gov/Newsroom/CPSC-RSS-Feed/Recalls-RSS,https://www.fda.gov/about-fda/contact-fda/stay-informed/rss-feeds/medwatch/rss.xml
MAX_TOPIC_ALLOWED_DOMAINS=github.blog,blog.cloudflare.com,react.dev,nodejs.org,techcrunch.com,theverge.com,engadget.com,arstechnica.com,venturebeat.com,electrek.co,supplychaindive.com,freightwaves.com,retaildive.com,marketingdive.com,bleepingcomputer.com,krebsonsecurity.com,cybersecuritydive.com,utilitydive.com,energy.gov,sebi.gov.in,rbi.org.in,sec.gov,ftc.gov,cpsc.gov,fda.gov
MAX_TOPIC_MAX_AGE_DAYS=14
AUTONOMOUS_SCHEDULER_ENABLED=false
AUTONOMOUS_INTERVAL_MINUTES=720
MAX_ADMIN_TOKEN=
BROWSER_EXECUTABLE_PATH=
BROWSER_TIMEOUT_MS=15000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
# Private semantic memories use a separate embedding model through the embedding-provider abstraction.
MEMORY_ENABLED=true
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_MS=10000
MEMORY_MAX_RECORDS=500
MEMORY_MAX_TEXT_CHARS=2000
MEMORY_MAX_EMBEDDING_BATCH=8
MEMORY_MAX_CANDIDATES=50
MEMORY_MAX_RESULTS=5
MEMORY_MAX_CONTEXT_CHARS=4000
MEMORY_MIN_SIMILARITY=0.45
# Optional Post Agent role overrides. Blank values inherit OPENROUTER_MODEL.
POST_AGENT_PLANNER_MODEL=
POST_AGENT_RESEARCH_MODEL=
POST_AGENT_VERIFIER_MODEL=
POST_AGENT_PLANNER_FALLBACK_MODEL=
POST_AGENT_RESEARCH_FALLBACK_MODEL=
POST_AGENT_VERIFIER_FALLBACK_MODEL=
POST_AGENT_MODEL_TIMEOUT_MS=20000
MAX_RESEARCH_STEPS=24
MAX_SEARCH_QUERIES=8
MAX_SOURCES=12
MAX_PAGES=8
MAX_RESEARCH_TIME_MS=180000
MAX_MODEL_DECISIONS=4
EVAL_MAX_RESEARCH_STEPS=8
EVAL_MAX_SEARCH_QUERIES=8
EVAL_MAX_SOURCES=4
EVAL_MAX_PAGES=2
EVAL_MAX_RESEARCH_TIME_MS=90000
EVAL_MAX_CASES=7
EVAL_OPENROUTER_TIMEOUT_MS=60000
EVAL_CASE_NAMES=
EVAL_SMOKE_MAX_RESEARCH_STEPS=4
EVAL_SMOKE_MAX_SEARCH_QUERIES=3
EVAL_SMOKE_MAX_SOURCES=2
EVAL_SMOKE_MAX_PAGES=1
EVAL_SMOKE_MAX_RESEARCH_TIME_MS=30000
EVAL_SMOKE_MAX_CASES=3
EVAL_SMOKE_OPENROUTER_TIMEOUT_MS=10000
EVAL_QUALITY_MAX_CASES=5
EVAL_QUALITY_MAX_RESEARCH_STEPS=16
EVAL_QUALITY_MAX_SEARCH_QUERIES=6
EVAL_QUALITY_MAX_SOURCES=6
